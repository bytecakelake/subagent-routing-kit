{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "spawn_agent|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/guard_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking subagent routing rules"
          }
        ]
      }
    ]
  }
}
